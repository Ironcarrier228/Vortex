{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vortex",
  "version": "0.1.0",
  "identifier": "ru.vortex.viz",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VORTEX — 3D центр визуализации",
        "width": 1680,
        "height": 1000,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#04060c",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "VORTEX",
    "shortDescription": "3D-центр визуализации данных",
    "longDescription": "Три 3D-сцены: живая карта сетевых соединений, анализатор диска и аудиовизуализатор системного звука.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
